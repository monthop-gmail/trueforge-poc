# Copy to .env and fill in. Never commit .env.
# The PoC scripts read these; they print no token values.

# --- Collaboration MCP (ai-collaboration-mcp) --------------------------------
COLLAB_ORIGIN=https://<collab-host>
COLLAB_MCP_URL=https://<collab-host>/mcp
COLLAB_TOKEN=<static bearer issued for this team>
# Participant name this connection claims. See the identity finding in
# docs/poc/dual-mcp-results.md — the server does not verify it against the token.
COLLAB_CLIENT_NAME=monthop-gmail/trueforge
COLLAB_EXPECT_IDENTITY=monthop-gmail/trueforge

# --- IT Operations hub (itops-mcp-hub) ---------------------------------------
ITOPS_BASE_URL=http://127.0.0.1:19080
ITOPS_IT_TOKEN=<IT role token of the sandbox deployment>
# Opt-in: registers an OAuth client on the target. Sandboxes only.
ITOPS_RUN_FLOW=0

# --- TrueForge harness --------------------------------------------------------
TRUEFORGE_URL=http://localhost:8790

# --- TrueFoundry AI Gateway (topology B) --------------------------------------
# Keep these in .env.tfy (gitignored, chmod 600), not here.
TRUEFOUNDRY_SERVICEFOUNDRY_SERVER_URL=https://<tenant>.truefoundry.cloud/api/svc
TRUEFOUNDRY_API_KEY=<personal access token>
TFY_TENANT=<tenant>
TFY_GATEWAY_BASE=https://gateway.truefoundry.ai
TFY_COLLAB_SERVER=ai-collaboration-mcp
TFY_ITOPS_SERVER=<itops-connector>
# Site IT role token, stored on the gateway connector. Enter it yourself; never paste it
# into a chat or a commit.
RYNST_IT_TOKEN=<IT role token of the site hub>
