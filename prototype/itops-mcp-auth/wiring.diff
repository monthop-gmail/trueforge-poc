-proxy_set_header X-MCP-Role $mcp_role;
+proxy_set_header X-MCP-Role $mcp_actor_role;
 
 # Cloudflare Access + MCP client headers (do not drop Authorization; hubs ignore it)
 proxy_set_header Authorization $http_authorization;
@@ -33,3 +33,8 @@ add_header Cache-Control "no-cache, no-store, must-revalidate";
