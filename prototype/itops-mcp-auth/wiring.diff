diff --git a/docker-compose.yml b/docker-compose.yml
index c506feb..47e61dd 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -37,6 +37,29 @@ services:
       PUBLIC_MCP_ORIGIN: ${PUBLIC_MCP_ORIGIN:-}
       PUBLIC_MCP_HOSTNAME: ${PUBLIC_MCP_HOSTNAME:-}
 
+  mcp-auth:
+    build:
+      context: .
+      dockerfile: packages/Dockerfile
+      args:
+        SERVICE: mcp-auth
+    restart: unless-stopped
+    logging: *default-logging
+    networks: [infra-net]
+    environment:
+      PORT: "3000"
+      IT_TOKEN: ${IT_TOKEN}
+      ADMIN_TOKEN: ${ADMIN_TOKEN}
+      ACCOUNTING_TOKEN: ${ACCOUNTING_TOKEN}
+      # Leave the JWT block empty to keep Bearer-only behaviour.
+      AUTH_JWT_ISSUER: ${AUTH_JWT_ISSUER:-}
+      AUTH_JWT_JWKS_URL: ${AUTH_JWT_JWKS_URL:-}
+      AUTH_JWT_AUDIENCES: ${AUTH_JWT_AUDIENCES:-}
+      AUTH_JWT_PRINCIPAL_ROLES: ${AUTH_JWT_PRINCIPAL_ROLES:-}
+      AUTH_JWT_DEFAULT_ROLE: ${AUTH_JWT_DEFAULT_ROLE:-}
+    expose:
+      - "3000"
+
   nginx:
     build:
       context: ./nginx
@@ -44,6 +67,8 @@ services:
     logging: *default-logging
     networks: [infra-net]
     depends_on:
+      mcp-auth:
+        condition: service_healthy
       mcp-hub-it:
         condition: service_healthy
       mcp-hub-admin:
